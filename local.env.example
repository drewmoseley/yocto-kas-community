# Copy to local.env (git-ignored) and edit for this host.
# Shared download and sstate caches, reused across releases and builds.
DL_DIR=/path/to/yocto-downloads
SSTATE_DIR=/path/to/yocto-sstate
# Per-release kas work dirs (repos, build/, logs/) are created under this.
WORK_ROOT=/path/to/yocto-builds/community-kas
# Optional: cap build parallelism (defaults to the CPU count). Use on a host
# with unstable memory, e.g. BB_NUMBER_THREADS=12 and PARALLEL_MAKE=-j8.
#BB_NUMBER_THREADS=12
#PARALLEL_MAKE=-j8
